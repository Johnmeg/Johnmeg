# ---------------------------------------------------------------- aplicación
PORT=3000
# En un servidor con proxy inverso (IIS/nginx) use 127.0.0.1 para que el puerto no quede expuesto
# HOST=127.0.0.1
# URL pública con la que los usuarios abren la aplicación (sin "/" final).
# La Redirect URI del cliente OAuth en SAC debe ser: <APP_BASE_URL>/auth/callback
APP_BASE_URL=http://localhost:3000
# Si la app está detrás de un proxy inverso / balanceador con HTTPS
TRUST_PROXY=false
# true obliga cookies "Secure" (por defecto: true si APP_BASE_URL es https)
# COOKIE_SECURE=true

# Mínimo 32 caracteres aleatorios. Genere uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
SESSION_MINUTES=60

# ---------------------------------------------------------------- SAP Analytics Cloud
# URL del tenant (sin /sap/fpa/...)
SAC_TENANT_URL=https://fanalca-clpriv-sac.us21.analytics.cloud.sap
# Sistema > Administración > App Integration: "Authorization URL" y "Token URL"
SAC_AUTHORIZE_URL=https://<subdominio>.authentication.us21.hana.ondemand.com/oauth/authorize
SAC_TOKEN_URL=https://<subdominio>.authentication.us21.hana.ondemand.com/oauth/token
# Cliente OAuth con Purpose = "Interactive Usage"
SAC_CLIENT_ID=
SAC_CLIENT_SECRET=
# Normalmente vacío
SAC_OAUTH_SCOPE=
# PKCE (recomendado). Póngalo en false sólo si su servidor de autorización lo rechaza.
SAC_OAUTH_PKCE=true

# ---------------------------------------------------------------- reglas de carga
MAX_FILE_MB=20
MAX_ROWS=100000
# Registros por envío al Data Import API
CHUNK_SIZE=10000
# es = 1.234.567,89 (Colombia)  |  en = 1,234,567.89
NUMBER_LOCALE=es
# Versiones que NO se pueden cargar desde archivo (separadas por coma)
BLOCKED_VERSIONS=public.Actual
# Validar códigos contra los maestros del modelo antes de enviar (Data Export API)
VALIDATE_MEMBERS=true

# ---------------------------------------------------------------- archivos
# AUDIT_FILE=logs/audit.log
# TEMPLATES_FILE=config/templates.json

# ---------------------------------------------------------------- diagnóstico
# true muestra en la consola cada llamada a SAC y el inicio de su respuesta
# (nunca el token). Úselo sólo para diagnosticar errores.
SAC_DEBUG=false
