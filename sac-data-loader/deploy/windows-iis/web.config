<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS como proxy inverso HTTPS delante de la aplicación Node (puerto 3000).
  Requisitos en el servidor:
    1. Módulos "URL Rewrite" y "Application Request Routing (ARR)".
    2. ARR > Server Proxy Settings > "Enable proxy" marcado; Time-out = 300 s.
    3. URL Rewrite > View Server Variables > Add: HTTP_X_FORWARDED_PROTO
  Copie este archivo a la carpeta física del sitio IIS (no a la carpeta de la app).
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Forzar HTTPS" stopProcessing="true">
          <match url="(.*)" />
          <conditions>
            <add input="{HTTPS}" pattern="off" />
          </conditions>
          <action type="Redirect" url="https://{HTTP_HOST}/{R:1}" redirectType="Permanent" />
        </rule>
        <rule name="Proxy a Node" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <!-- Node necesita saber que el usuario entró por HTTPS para enviar la cookie segura -->
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:3000/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <security>
      <requestFiltering>
        <!-- 25 MB: un poco más que MAX_FILE_MB=20 -->
        <requestLimits maxAllowedContentLength="26214400" />
      </requestFiltering>
    </security>
    <!-- Deja pasar los mensajes de error JSON de la aplicación sin reemplazarlos por páginas de IIS -->
    <httpErrors existingResponse="PassThrough" />
  </system.webServer>
</configuration>
