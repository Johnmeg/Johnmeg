      {
        "nombre": "CANTIDAD",
        "fijo": {
          "Ratio": "<cuenta cantidad>"
        },
        "variar": {
          "Sociedades": "@PRECIO",
          "Cebes": "@PRECIO"
        },
        "min": 1,
        "max": 500,
        "decimales": 2
      }
    ],
    "esperado": [
      {
        "nombre": "INGRESO",
        "fijo": {
          "Ratio": "<cuenta resultado>"
        },
        "variar": {
          "Sociedades": "@PRECIO",
          "Cebes": "@PRECIO"
        },
        "formula": "v('PRECIO') * v('CANTIDAD')"
      }
    ],
    "tolerancia": 0.01
